<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hũ Tương Trợ Cộng Đồng - Máy Chủ Quản Lý</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col items-center justify-between p-4">

    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl overflow-hidden flex flex-col min-h-[85vh]">
        
        <header class="bg-gradient-to-r from-red-600 to-orange-600 p-6 text-center text-white relative">
            <h1 class="text-2xl font-black tracking-wider uppercase">Hũ Tương Trợ 💣</h1>
            <p class="text-xs text-orange-100 mt-1 opacity-90">Lan tỏa sự tử tế - Gỡ rối tài chính minh bạch</p>
            <div class="absolute top-3 right-3 flex gap-1">
                <button onclick="openAdminModal()" class="text-[10px] bg-black/40 hover:bg-black/60 px-2 py-1 rounded-full transition text-amber-300 font-bold">🛡️ Admin</button>
                <button onclick="resetRole()" class="text-[10px] bg-black/30 hover:bg-black/50 px-2 py-1 rounded-full transition text-slate-200">Đổi vai</button>
            </div>
        </header>

        <main id="app-content" class="p-5 flex-1 flex flex-col justify-between">
            <!-- Render bằng JS -->
        </main>

        <footer class="bg-slate-950/50 py-3 px-6 text-center text-xs text-slate-500 border-t border-slate-800/60">
            Hệ thống Tương trợ Máy chủ &copy; 2026
        </footer>
    </div>

    <script>
        // Tự nhận diện URL (chạy dưới máy thì là localhost:3000, chạy online trên Render tự đổi sang domain thực tế)
        const API_URL = window.location.origin + '/api';
        let currentRole = localStorage.getItem('app_role') || null;
        let hasAgreedTerms = localStorage.getItem('app_terms') === 'true';
        let hũNợList = [];

        async function fetchFunds() {
            try {
                let res = await fetch(`${API_URL}/funds`);
                hũNợList = await res.json();
                renderApp();
            } catch (err) {
                console.error("Lỗi kết nối máy chủ:", err);
            }
        }

        function renderApp() {
            const container = document.getElementById('app-content');
            
            if (!hasAgreedTerms) {
                container.innerHTML = renderTermsScreen();
                return;
            }

            if (!currentRole) {
                container.innerHTML = renderRoleSelector();
                return;
            }

            if (currentRole === 'borrower') {
                container.innerHTML = renderBorrowerDashboard();
            } else if (currentRole === 'donor') {
                container.innerHTML = renderDonorDashboard();
            }
        }

        function renderTermsScreen() {
            return `
                <div class="space-y-4 flex flex-col h-full justify-between">
                    <div>
                        <h2 class="text-base font-bold text-orange-500 mb-2 flex items-center gap-2">
                            <span>📜</span> ĐIỀU KHOẢN & CAM KẾT HOẠT ĐỘNG
                        </h2>
                        <div class="space-y-2 text-[11px] text-slate-300 max-h-[46vh] overflow-y-auto pr-1 bg-slate-950/40 p-3 rounded-xl border border-slate-800 leading-relaxed">
                            <p>1. <strong>Quyền thu hồi/đổi hũ (42h):</strong> Người cho vay có quyền đổi người nhận hoặc nhận lại số tiền nếu sau 42 giờ mà hũ chưa đầy.</p>
                            <p>2. <strong>Xác thực định danh:</strong> Bắt buộc cung cấp CCCD, SĐT và quét khuôn mặt eKYC.</p>
                            <p>3. <strong>Trách nhiệm pháp lý:</strong> Người xin chịu hoàn toàn trách nhiệm trước pháp luật nếu có dấu hiệu lừa đảo.</p>
                            <p>4. <strong>Giới hạn xin:</strong> Tối đa 2 triệu đồng/lần và tối đa 3 lần suốt đời app.</p>
                            <p>5. <strong>Tâm thế người cho:</strong> Hoàn toàn tự nguyện, xem như tiền tích phước.</p>
                            <p>6. <strong>Phí lọc máy chủ:</strong> 50k phí lọc hồ sơ chuyển về máy chủ, không hoàn trả.</p>
                        </div>
                    </div>
                    <button onclick="acceptTerms()" class="w-full bg-gradient-to-r from-orange-500 to-red-600 text-white font-bold py-3.5 rounded-xl shadow-lg transition text-xs">
                        Tôi đã đọc và Đồng ý toàn bộ cam kết ✅
                    </button>
                </div>
            `;
        }

        function acceptTerms() {
            hasAgreedTerms = true;
            localStorage.setItem('app_terms', 'true');
            renderApp();
        }

        function renderRoleSelector() {
            return `
                <div class="flex flex-col justify-center items-center h-full py-8 space-y-5 text-center">
                    <h2 class="text-lg font-bold text-white">Bạn tham gia với tư cách gì?</h2>
                    <div class="w-full space-y-3">
                        <button onclick="selectRole('borrower')" class="w-full bg-slate-800 border border-slate-700 p-4 rounded-2xl flex items-center justify-between text-left">
                            <div>
                                <div class="font-bold text-orange-400 text-sm">Người Mang Nợ (Người Xin)</div>
                                <div class="text-[11px] text-slate-400">Nộp 50k phí lọc, nhập thông tin & theo dõi tiến trình</div>
                            </div>
                            <span>🛡️</span>
                        </button>
                        <button onclick="selectRole('donor')" class="w-full bg-slate-800 border border-slate-700 p-4 rounded-2xl flex items-center justify-between text-left">
                            <div>
                                <div class="font-bold text-emerald-400 text-sm">Người Trả Nợ (Thùng Công Đức)</div>
                                <div class="text-[11px] text-slate-400">Tùy hỷ gieo duyên, kết nối ngân hàng tự động trừ</div>
                            </div>
                            <span>🎁</span>
                        </button>
                    </div>
                </div>
            `;
        }

        function selectRole(role) {
            currentRole = role;
            localStorage.setItem('app_role', role);
            renderApp();
        }

        function resetRole() {
            const pin = prompt("Nhập mã bảo vệ đổi vai trò (Mặc định: 1234):");
            if (pin === "1234") {
                localStorage.removeItem('app_role');
                currentRole = null;
                renderApp();
            }
        }

        async function openAdminModal() {
            const pin = prompt("Nhập mã PIN Quản Trị Máy Chủ (Mặc định: 1234):");
            if (!pin) return;
            try {
                let res = await fetch(`${API_URL}/admin/login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ pin })
                });
                let data = await res.json();
                if (data.success) {
                    alert(`🛡️ ĐĂNG NHẬP ADMIN THÀNH CÔNG!\n\n- Tổng phí lọc thu về: ${data.settings.totalFilterFees.toLocaleString()}đ\n- Tổng số hũ đang quản lý: ${data.totalFunds} hũ`);
                } else {
                    alert("Sai mã PIN quản trị!");
                }
            } catch (err) {
                alert("Không thể kết nối tới máy chủ quản lý!");
            }
        }

        function renderBorrowerDashboard() {
            let myHu = hũNợList[0] || { current: 0, target: 1500000, status: 'active', connectedPhones: [] };
            let percent = Math.min(100, Math.round((myHu.current / myHu.target) * 100));

            return `
                <div class="space-y-3 flex flex-col justify-between h-full">
                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <h2 class="font-bold text-xs text-orange-400">📊 Tiến Trình Nhận Tiền Hũ</h2>
                            <span class="text-[10px] bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded-full">eKYC Duyệt ✅</span>
                        </div>
                        <div class="bg-slate-800/80 border border-slate-700 p-3.5 rounded-2xl space-y-2.5">
                            <div class="flex justify-between text-xs">
                                <span class="text-slate-400">Đã nhận / Mục tiêu:</span>
                                <span class="font-bold text-white">${myHu.current.toLocaleString()}đ / ${myHu.target.toLocaleString()}đ (${percent}%)</span>
                            </div>
                            <div class="w-full bg-slate-950 h-2.5 rounded-full overflow-hidden border border-slate-700">
                                <div class="bg-gradient-to-r from-orange-500 to-emerald-400 h-full transition-all" style="width: ${percent}%"></div>
                            </div>
                        </div>
                    </div>
                    <button onclick="openCreateHuModal()" class="w-full bg-gradient-to-r from-orange-500 to-red-600 text-white font-bold py-2.5 rounded-xl text-xs shadow">
                        + Tạo Hũ Mới (Nộp 50k phí lọc máy chủ) 🛡️
                    </button>
                </div>
            `;
        }

        async function openCreateHuModal() {
            let name = prompt("1. Nhập Họ và Tên thật:");
            if(!name) return;
            let cccd = prompt("2. Nhập số CCCD (eKYC):");
            if(!cccd) return;
            let phone = prompt("3. Nhập SĐT liên lạc:");
            if(!phone) return;
            let stk = prompt("4. Nhập Ngân hàng + Số tài khoản nhận tiền:");
            if(!stk) return;
            let target = parseInt(prompt("5. Nhập số tiền cần xin (Tối đa 2.000.000đ):", "1000000"));
            let reason = prompt("6. Nêu hoàn cảnh khó khăn:");

            let pay50k = confirm(`⚠️ XÁC NHẬN NỘP PHÍ LỌC:\n- Phí 50.000đ sẽ chuyển về TK Máy chủ.\nBấm [OK] để xác nhận.`);
            if(!pay50k) return;

            let res = await fetch(`${API_URL}/funds`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, cccd, phone, stk, target, reason })
            });
            let data = await res.json();
            if(data.success) {
                alert("🎉 Khởi tạo hũ thành công trên máy chủ!");
                fetchFunds();
            }
        }

        function renderDonorDashboard() {
            let listHTML = hũNợList.map(hũ => {
                let percent = Math.min(100, Math.round((hũ.current / hũ.target) * 100));
                let isFull = hũ.current >= hũ.target;
                return `
                    <div class="bg-slate-800/80 border border-slate-700 p-3.5 rounded-2xl space-y-2">
                        <div class="flex justify-between items-start">
                            <div>
                                <div class="font-bold text-white text-xs">${hũ.name} <span class="text-[9px] text-emerald-400">✔ eKYC</span></div>
                                <div class="text-[10px] text-slate-400">${hũ.reason}</div>
                            </div>
                            <span class="text-xs font-bold text-orange-400">${percent}%</span>
                        </div>
                        <div class="w-full bg-slate-900 h-2 rounded-full overflow-hidden">
                            <div class="bg-gradient-to-r from-orange-500 to-emerald-400 h-full" style="width: ${percent}%"></div>
                        </div>
                        <div class="flex justify-between items-center text-[10px] text-slate-400">
                            <span>Đã nhận: <b class="text-white">${hũ.current.toLocaleString()}đ</b></span>
                            ${isFull ? '<span class="text-emerald-400 font-bold">Đã Đủ Hũ</span>' : `<button onclick="donateToFund(${hũ.id})" class="bg-orange-500 text-white font-bold px-2.5 py-1 rounded-lg">Gieo Duyên 💳</button>`}
                        </div>
                    </div>
                `;
            }).join('');

            return `
                <div class="space-y-3 flex flex-col h-full justify-between">
                    <div>
                        <h2 class="font-bold text-xs text-emerald-400 mb-2">🎁 Thùng Công Đức (Tương Trợ)</h2>
                        <div class="space-y-2.5 max-h-[55vh] overflow-y-auto pr-1">${listHTML}</div>
                    </div>
                    <div class="bg-slate-950/60 border border-slate-800 p-2 rounded-xl text-[10px] text-slate-400">
                        💡 Tiền chuyển từ TKNH của bạn sẽ về quỹ máy chủ. Đủ 100% tự động giải ngân!
                    </div>
                </div>
            `;
        }

        async function donateToFund(id) {
            let donorName = prompt("Nhập tên hiển thị (hoặc để trống ẩn danh):", "Mạnh thường quân");
            let donorPhone = prompt("Nhập SĐT của bạn:", "09");
            let amount = parseInt(prompt("Nhập số tiền gieo duyên (VNĐ):", "50000"));
            if(!amount || isNaN(amount)) return;

            let confirmBank = confirm(`💳 XÁC NHẬN CHUYỂN KHOẢN:\n- Số tiền: ${amount.toLocaleString()}đ\n- Chuyển về: TK Máy Chủ`);
            if(!confirmBank) return;

            let res = await fetch(`${API_URL}/funds/${id}/donate`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ donorName, donorPhone, amount })
            });
            let data = await res.json();
            if(data.success) {
                if(data.hu.status === 'success') {
                    confetti({ particleCount: 150, spread: 80, origin: { y: 0.6 } });
                    alert("🎉 Hũ đã đủ 100% và tự động nổ bom giải ngân về người nhận!");
                } else {
                    alert("❤️ Gieo duyên thành công!");
                }
                fetchFunds();
            }
        }

        fetchFunds();
    </script>
</body>
</html>
